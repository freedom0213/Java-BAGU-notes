# 默认按文本处理并统一 LF 落盘（避免 Windows 上冒出
# "LF will be replaced by CRLF" 一类警告）
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则老版本 cmd 可能出错
*.bat text eol=crlf

# 其余文本统一 LF
*.md   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf

# 二进制资源不要做换行转换
*.png  binary
*.jpg  binary
*.ico  binary
